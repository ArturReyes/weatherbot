# === WEATHERBOT — LIVE TRADING SECRETS ===
# Copy this file to .env and fill in your keys.
# .env is in .gitignore — your secrets stay local.
#
# HOW TO GET EACH KEY:
#
#   PK  (REQUIRED)  — Your Polygon wallet private key (0x...)
#     MetaMask → three dots → Account details → Show private key
#     This key signs your orders on Polymarket.
#
#   WALLET (optional) — Your wallet address (0x...)
#     Derived from PK automatically if omitted.
#
#   VC_KEY (optional) — Visual Crossing API key
#     Sign up: https://www.visualcrossing.com/weather-api
#     Free tier: 1,000 queries/day. Used only for diagnostic comparison;
#     Polymarket settlement is authoritative for calibration.
#
#   TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID (optional)
#     Talk to @BotFather → /newbot → copy token
#     Then get chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates

# === REQUIRED ===
# PK=0x...

# === OPTIONAL ===
# WALLET=0x...
# VC_KEY=your_visual_crossing_key
# TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# TELEGRAM_CHAT_ID=123456789
# Optional identity sent to Open-Meteo and Aviation Weather.
WEATHER_API_USER_AGENT="WeatherBet/1.0 weather-trading-operator"
